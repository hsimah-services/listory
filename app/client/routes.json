{
  "runtime": "@tsquid/routes",
  "routes": [
    {
      "name": "Home",
      "entryPoint": "src/components/home/Home.entrypoint.ts",
      "path": "/",
      "fields": {},
      "query": "HomePageQuery"
    },
    {
      "name": "ListIndex",
      "entryPoint": "src/components/list/List.entrypoint.ts",
      "path": "/lists",
      "fields": { "term": { "kind": "string", "optional": true } },
      "query": "ListPageQuery"
    },
    {
      "name": "ListDetail",
      "entryPoint": "src/components/list/List.entrypoint.ts",
      "path": "/lists/:id",
      "fields": {
        "term": {
          "kind": "string",
          "optional": true
        },
        "id": {
          "kind": "string"
        }
      },
      "query": "ListPageQuery"
    },
    {
      "name": "ChecklistIndex",
      "entryPoint": "src/components/checklist/Checklist.entrypoint.ts",
      "path": "/checklists",
      "fields": {},
      "query": null
    }
  ],
  "persistedQueries": "persisted_queries.json"
}
